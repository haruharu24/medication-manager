PORT=8787
PUBLIC_SERVER_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:3000

# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com

# Used to sign login sessions for account/household sync. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Shared secret for RevenueCat's webhook (POST /api/webhooks/revenuecat), used to
# update subscriptionStatus for the family-sharing paywall. Must match the secret
# configured in the RevenueCat dashboard's webhook settings. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVENUECAT_WEBHOOK_SECRET=
